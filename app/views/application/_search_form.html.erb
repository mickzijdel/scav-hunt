<%# locals: (sort_options:) %>
<div class="mb-3">
    <%# autocomplete="off": this filters the list already on the page through the
        challenge-sorting Stimulus controller. It is not a form field, nothing is submitted
        or saved, so there is no value the browser could usefully remember or prefill. %>
    <input type="text" class="form-control" placeholder="Search..." aria-label="Search" autocomplete="off" data-challenge-sorting-target="searchInput" data-action="input->challenge-sorting#search">
    <select class="form-select mt-2" aria-label="Sort by" data-challenge-sorting-target="sortSelect" data-action="change->challenge-sorting#sort">
        <option value="">Sort by...</option>
        <% sort_options.each do |key, value| %>
        <option value="<%= value %>"><%= key %></option>
        <% end %>
  </select>
</div>
