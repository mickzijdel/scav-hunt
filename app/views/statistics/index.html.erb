<% content_for :head do %>
  <%# Served from the installed billboard.js package (see config/initializers/assets.rb),
      so it always matches the version bundled into application.js. The CDN link this
      replaces was pinned to 3.13.0 while package.json is on 4.x. %>
  <%= stylesheet_link_tag "billboard", "data-turbo-track": "reload" %>
<% end %>

<div data-controller="statistics"
     data-statistics-created-at-data-value="<%= @created_at_data.to_json %>"
     data-statistics-updated-at-data-value="<%= @updated_at_data.to_json %>">
  <h2>Score Over Time (Created At)</h2>
  <div id="createdAtChart">Loading...</div>

  <h2>Score Over Time (Updated At)</h2>
  <div id="updatedAtChart">Loading...</div>
</div>
