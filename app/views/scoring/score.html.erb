<%# TODO: Add undo button for edits, probably using papertrail (it says the most recent version is not compatible with Rails 7.2 but it should work fine). %>

<%# Every scorer looking at this team shares one stream, so a score entered by one of
    them lands on the others' screens without anybody reloading. %>
<%= turbo_stream_from @team, :scoring %>

<div data-controller="challenge-sorting"
     data-action="turbo:before-stream-render@document->challenge-sorting#refresh">
  <%= render 'application/search_form', sort_options: {
    "Number" => "number",
    "Group ID" => "groupId",
    "Description" => "description",
    "Points To Win" => "points",
    "Status" => "status"
    }
  %>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>#</th>
        <th>Group ID</th>
        <th>Description</th>
        <th>Points To Win</th>
        <th>Regular Points</th>
        <th>Bonus Points</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @challenges.each do |challenge| %>
        <% result = @results[challenge.id] %>
        <tr data-challenge-sorting-target="row" data-challenge-id="<%= challenge.id %>">
          <td data-column="number"><%= challenge.number %></td>
          <td data-column="groupId"><%= challenge.group_id %></td>
          <td data-column="description"><%= challenge.description %></td>
          <td data-column="points"><%= challenge.points %></td>

          <%= render 'scoring/points_field', challenge: challenge, team: @team, result: result, field: :regular_points %>
          <%= render 'scoring/points_field', challenge: challenge, team: @team, result: result, field: :bonus_points %>
          <%= render 'scoring/status', challenge: challenge, result: result %>

          <td>
            <%= button_to 'Full Points', scoring_update_path,
                          params: { challenge_id: challenge.id, user_id: @team.id, regular_points: challenge.points },
                          class: 'btn btn-sm btn-primary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p><strong>Total Points: <%= render 'application/total_points', team: @team, id: 'scoring_total_points' %></strong></p>
</div>

<h3>Group Visibility</h3>
<%= render 'group_permissions/table', users: [@team] %>

<h3>Change Team</h3>
<nav aria-label="Navigate to other teams for scoring">
  <ul class="pagination">
    <% User.teams_by_name.each do |user| %>
      <li class="page-item"><a class="page-link" href="<%= scoring_score_path(user) %>"><%= user.name %></a></li>
    <% end %>
  </ul>
</nav>
