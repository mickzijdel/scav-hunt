<%# FIXME: It would be nice if the completion stats are also updated in real-time. Probably needs another challenge-wide stream. %>

<%# A team's own scores land here as they are awarded. The stream name is signed and
    rendered only into this team's page, so it is also what keeps one team's scores
    off another team's screen. %>
<% if current_user&.team? %>
  <%= turbo_stream_from current_user, :challenges %>
<% end %>

<%# Rows arrive from a broadcast whenever a score or a group permission changes, so
    the search and sort the viewer has applied have to be put back afterwards. %>
<div data-controller="challenge-sorting"
     data-action="turbo:before-stream-render@document->challenge-sorting#refresh">
  <%# Different sort options for teams and scorers %>
  <%= render 'application/search_form', sort_options: current_user&.team? ? {
    "Number" => "number",
    "Description" => "description",
    "Points To Win" => "points",
    "Obtained Points" => "regularPoints",
    "Bonus Points" => "bonusPoints",
    "Status" => "status"
    } : {
    "Number" => "number",
    "Group ID" => "groupId",
    "Description" => "description",
    "Points To Win" => "points",
    "Completed" => "completed",
    "Partially Completed" => "partiallyCompleted",
    "Not Attempted" => "notAttempted"
    }
  %>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>#</th>

        <% unless current_user&.team? %>
          <th>Group ID</th>
        <% end %>
        <th>Description</th>
        <th>Points To Win</th>

        <%# A team sees its own score for each challenge; everybody else sees how the field is
            doing on it. Only the headings differ, so name them rather than repeating <th> in
            both branches of an if. %>
        <% score_headings = if current_user&.team?
                              [ "Obtained Points", "Bonus Points", "Status" ]
                            else
                              [ "Completed", "Partially Completed", "Not Attempted", "Actions" ]
                            end %>
        <% score_headings.each do |heading| %>
          <th><%= heading %></th>
        <% end %>
      </tr>
    </thead>
    <tbody id="challenge_list">
      <%= render 'challenge_list', challenges: @challenges, results: @results, current_user: current_user %>
    </tbody>
  </table>

  <% if current_user&.team? %>
    <p><strong>Total Points: <%= render 'application/total_points', team: current_user, id: 'team_total_points' %></strong></p>
  <% end %>

  <% if can? :create, Challenge %>
    <%= link_to 'New Challenge', new_challenge_path, class: 'btn btn-primary' %>
  <% end %>

  <% if can? :import, Challenge %>
    <%= link_to 'Import Challenges', import_form_challenges_path, class: 'btn btn-secondary' %>
  <% end %>

  <% if can? :export, Challenge %>
    <%= link_to 'Export Challenges', export_challenges_path, class: 'btn btn-secondary' %>
  <% end %>
</div>
