<%= stylesheet_link_tag "login" %>

<div class="container form-container">
  <div class="form-box">
    <h2>Sign up</h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%# :name and :role are required by User but Devise's sign_up sanitiser does not accept
          them, so a sign-up always fails on those two. They have no input here to sit under,
          which made the failure completely silent -- list them so the user sees why.
          FIXME: this form cannot succeed as it stands. Either drop :registerable from User
          (accounts are created by an admin through users#new) or permit :name and default
          :role through a Devise param sanitiser. %>
      <%= render "application/forms/errors",
                 errors: resource.errors,
                 model_name: resource.model_name.human.downcase,
                 attributes: [ :base, :name, :role ] %>

      <%= f.input :email, input_html: { autofocus: true, autocomplete: "email" } %>

      <%= f.input :password,
                  hint: @minimum_password_length && "#{@minimum_password_length} characters minimum",
                  input_html: { autocomplete: "new-password" } %>

      <%= f.input :password_confirmation, input_html: { autocomplete: "new-password" } %>

      <%= f.button :submit, "Sign up", class: "btn btn-secondary" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
