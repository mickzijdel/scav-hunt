<%= stylesheet_link_tag "login" %>

<div class="container form-container">
  <div class="form-box">
    <h2>Forgot your password?</h2>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "application/forms/errors", errors: resource.errors, model_name: resource.model_name.human.downcase %>

      <%= f.input :email, input_html: { autofocus: true, autocomplete: "email" } %>

      <%= f.button :submit, "Send me reset password instructions", class: "btn btn-secondary" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
