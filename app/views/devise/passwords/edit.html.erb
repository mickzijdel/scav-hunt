<%= stylesheet_link_tag "login" %>

<div class="container form-container">
  <div class="form-box">
    <h2>Change your password</h2>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%# The token is a hidden field, so an error on it has no input to sit under -- it has to
          go in the summary or the user is told nothing at all when their reset link expires. %>
      <%= render "application/forms/errors",
                 errors: resource.errors,
                 model_name: resource.model_name.human.downcase,
                 attributes: [ :base, :reset_password_token ] %>

      <%# Plain hidden_field, not `f.input ... as: :hidden`: no :hidden wrapper is configured,
          so simple_form would fall back to :vertical_form and wrap the hidden input in an
          `mb-3` div plus a `full_error` that repeats the summary message. %>
      <%= f.hidden_field :reset_password_token %>

      <%= f.input :password,
                  label: "New password",
                  hint: @minimum_password_length && "#{@minimum_password_length} characters minimum",
                  input_html: { autofocus: true, autocomplete: "new-password" } %>

      <%= f.input :password_confirmation,
                  label: "Confirm new password",
                  input_html: { autocomplete: "new-password" } %>

      <%= f.button :submit, "Change my password", class: "btn btn-secondary" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
