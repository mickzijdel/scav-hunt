<%= stylesheet_link_tag "scoreboard" %>

<%# The scoreboard is kept fresh by page-refresh broadcasts (Result broadcasts to
    :scoreboard on every save). A refresh re-renders this page *for each viewer*, so
    the rank order, the scorer-only stat columns, the "this is your team" highlight
    and the scoreboard_visible gate are all applied per session -- none of which a
    single broadcast of pre-rendered HTML could do. Morphing keeps scroll position
    and leaves the countdown element alone. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% turbo_exempts_page_from_cache %>

<% if @scoreboard_visible %>
  <%= turbo_stream_from :scoreboard %>

  <div class="mb-4">
    <div id="timer" data-controller="countdown" data-countdown-end-time-value="<%= @end_time&.iso8601 %>">
      <%= countdown_to(@end_time) %>
    </div>
  </div>

  <table class="table table-warning table-striped">
    <thead>
      <tr>
        <th>Rank</th>
        <th>Team</th>
        <th>Score</th>

        <% if can? :manage, :scoring %>
          <th>Completed</th>
          <th>Partially Completed</th>
          <th>Not Attempted</th>
        <% end %>
      </tr>
    </thead>
    <tbody id="scoreboard_rows">
      <% @teams.each_with_index do |team, index| %>
        <tr data-team-id="<%= team.id %>" class="<%= 'table-primary' if team == current_user %>">
          <td data-rank><%= index + 1 %></td>
          <td>
            <% if can? :manage, :scoring %>
              <%= link_to team.name, scoring_score_path(team) %>
            <% else %>
              <%= team.name %>
            <% end %>
          </td>
          <td data-score><%= team.total_points %></td>

          <% if can? :manage, :scoring %>
            <% stats = team.stats %>
            <td data-completed><%= stats[:completed] %></td>
            <td data-partially-completed><%= stats[:partially_completed] %></td>
            <td data-not-attempted><%= stats[:not_attempted] %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>The scoreboard is currently not visible. HAL is watching.</p>
<% end %>
