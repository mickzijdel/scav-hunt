<nav class="navbar bg-dark navbar-expand-lg bg-body-tertiary" data-bs-theme="dark">
  <div class="container-fluid">
    <%= link_to image_tag("scoreboard_icon.png", alt: "Scav Hunt home", style: "width: 50px"), root_path %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <% if user_signed_in? %>
        <span class="navbar-text me-auto">
          Welcome <%= current_user.name %>
        </span>
      <% end %>

      <ul class="navbar-nav mb-2 mb-lg-0">
        <%# Navbar items is a function in the application_helper %>
        <% navbar_items.each_with_index do |navbar_item, index| %>
          <%# Add in columns to pad the auto to make sure the full width of the row is taken up, which a row of only col-auto's won't do %>
          <% if index > 0 %>
            <div class="col"></div>
          <% end %>

          <div class="col-lg-auto">
            <li class="nav-item <%= navbar_item[:item_class] %>">
              <%# current_page? replaces an @current_path ivar that no controller ever set,
                 # so the active state could never appear. %>
              <% current = current_page?(navbar_item[:path]) %>
              <% navbar_item_class = "nav-link mx-1#{' active' if current}" %>

              <% if navbar_item[:method].blank? || navbar_item[:method] == :get %>
                <%= link_to(navbar_item[:title], navbar_item[:path], class: navbar_item_class, aria: { current: ("page" if current) }) %>
              <% else %>
                <%= button_to(navbar_item[:title], navbar_item[:path], method: navbar_item[:method], class: navbar_item_class) %>
              <% end %>
            </li>
          </div>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
