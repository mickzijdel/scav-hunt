<% flash.each do |key, message| %>
  <%# The <div> used to be opened separately in each branch of the if/elsif/else and closed
      once at the bottom, which leaves the template with unbalanced tags as far as any parser
      is concerned. Only the modifier class differs, so pick that first and open the tag once. %>
  <% modifier = case key
                when "notice" then "alert-success"
                when "alert"  then "alert-danger"
                else               "alert-warning"
                end %>
  <div class="alert <%= modifier %> alert-dismissible fade show" role="alert">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
