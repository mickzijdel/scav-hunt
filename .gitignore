# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Coverage
/coverage

# Git worktrees for parallel agent work. `.worktrees` is the manual `git worktree add`
# location; `.claude/worktrees` is where Claude Code's native worktree tool puts them.
# Both hold separate checkouts whose contents must never be tracked by this repo.
/.worktrees
/.claude/worktrees

# Bundler's vendored gem path. CI (ruby/setup-ruby with bundler-cache) installs into
# vendor/bundle inside the checkout; keep those gems out of git, out of `git ls-files`,
# and out of the jscpd/debride/flay/fasterer scans.
/vendor/bundle

# Machine-local mise overrides. The committed mise.toml is the source of truth (it carries
# the DEV_ENV_VERSION stamp); mise.local.toml is for per-machine tweaks only.
/mise.local.toml
